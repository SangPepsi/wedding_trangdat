# Copy file này thành .env.local:  copy .env.example .env.local
# Khi deploy lên Vercel, khai báo các biến này trong Settings → Environment Variables

# Formspree - nhận form Xác nhận tham dự qua email (bắt buộc)
# 1. Đăng ký miễn phí tại https://formspree.io
# 2. Tạo form mới → lấy Form ID (ví dụ: xyzabc từ URL https://formspree.io/f/xyzabc)
NEXT_PUBLIC_FORMSPREE_ID=your_form_id

# URL trang web - dùng cho ảnh xem trước khi chia sẻ link (Zalo, Facebook)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Sổ lưu bút (không bắt buộc) - để trống thì phần Sổ lưu bút tự ẩn trên bản deploy
# Vercel → Storage → Upstash Redis → Connect vào project: Vercel tự thêm 2 biến KV_REST_API_* bên dưới.
# Chạy trên máy: copy 2 giá trị đó từ Vercel (Settings → Environment Variables) vào .env.local
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Dùng chung database với thiệp khác thì đặt tiền tố riêng để không lẫn dữ liệu, ví dụ: trangdat:
REDIS_KEY_PREFIX=

# Mật khẩu vào trang /quan-ly-loi-chuc để xoá lời chúc
GUESTBOOK_ADMIN_PASSWORD=
