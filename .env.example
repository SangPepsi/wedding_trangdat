# Formspree - Nhận RSVP từ form Xác nhận tham dự
# 1. Đăng ký miễn phí tại https://formspree.io
# 2. Tạo form mới → lấy Form ID (ví dụ: xyzabc từ URL https://formspree.io/f/xyzabc)
# 3. Copy file này thành .env.local: copy .env.example .env.local
# 4. Thay your_form_id bằng Form ID thật
NEXT_PUBLIC_FORMSPREE_ID=your_form_id

# URL trang web (cho Open Graph khi chia sẻ link) - ví dụ: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
